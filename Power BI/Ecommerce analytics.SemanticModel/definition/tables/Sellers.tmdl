	column seller_state
		dataType: string
		lineageTag: 9eef6cac-04a1-4b70-aead-64392118aa7e
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: seller_state

		annotation SummarizationSetBy = Automatic

	column 'Seller Map Location' = Sellers[State Name] & ", Brazil"
		lineageTag: 437e9938-92ef-42b4-8ec8-0545ab7c46e7
		dataCategory: StateOrProvince
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'State Name' =
			
			SWITCH(Sellers[seller_state],
			"AC","Acre","AL","Alagoas","AP","Amapá","AM","Amazonas","BA","Bahia",
			"CE","Ceará","DF","Distrito Federal","ES","Espírito Santo","GO","Goiás",
			"MA","Maranhão","MT","Mato Grosso","MS","Mato Grosso do Sul","MG","Minas Gerais",
			"PA","Pará","PB","Paraíba","PR","Paraná","PE","Pernambuco","PI","Piauí",
			"RJ","Rio de Janeiro","RN","Rio Grande do Norte","RS","Rio Grande do Sul",
			"RO","Rondônia","RR","Roraima","SC","Santa Catarina","SP","São Paulo",
			"SE","Sergipe","TO","Tocantins",
			Sellers[seller_state])
		lineageTag: 8620f0d9-eb15-42e3-9140-de1f844d20dc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Sellers = m
		mode: import
		source =
				let
				    Source = MySQL.Database("localhost:3306", "ecommerce_analytics", [ReturnSingleDatabase=true]),
				    ecommerce_analytics_sellers = Source{[Schema="ecommerce_analytics",Item="sellers"]}[Data],
				    #"Removed Duplicates" = Table.Distinct(ecommerce_analytics_sellers, {"seller_id"}),
				    #"Trimmed Text" = Table.TransformColumns(#"Removed Duplicates",{{"seller_id", Text.Trim, type text}}),
				    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"seller_id", Text.Clean, type text}})
				in
				    #"Cleaned Text"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

