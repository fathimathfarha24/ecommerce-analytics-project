		annotation SummarizationSetBy = Automatic

	column seller_zip_code_prefix
		dataType: int64
		formatString: 0
		lineageTag: da6fc09f-6531-43ab-9fe2-dd3006ecd1e7
		summarizeBy: none
		sourceColumn: seller_zip_code_prefix

